package biblioteca.refactorizacion;

/** Implementación concreta de email. Fácil de sustituir por SMS sin tocar el resto. */
public class NotificacionEmail implements ServicioNotificacion {
    @Override
    public void enviar(String destinatario, String mensaje) {
        System.out.println("[EMAIL] Para: " + destinatario + " | " + mensaje);
    }
}